# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# XRay Configuration
XRAY_BINARY=xray
XRAY_CONFIG=/etc/xray/config.json
XRAY_LOCATION_ASSET=/usr/share/xray

# XRay gRPC API
XRAY_API_ADDRESS=127.0.0.1:10085

# Публичный адрес сервера для subscription-ссылок
SERVER_PUBLIC_HOST=your-server.com

# JWT Auth
AUTH_JWT_SECRET=your-super-secret-key-change-me-plz

# Database
DB_PATH=/data/panel.db

# Optional
MODE=production